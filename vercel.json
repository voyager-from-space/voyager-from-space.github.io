{
  "buildCommand": "",
  "outputDirectory": "public",
  "headers": [
    { "source": "/(.*).json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(.*)", "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
